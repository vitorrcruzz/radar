# Copie este arquivo para .env e substitua pelos valores da rede autorizada.
# Exemplo de sub-rede; ajuste para a rede real onde o servidor RADAR terá acesso.
SCAN_NETWORK=192.168.1.0/24

# Community SNMP v1/v2c do equipamento de teste (não é a senha do Windows/Linux).
# Mantenha o .env fora do Git; prefira SNMPv3 quando disponível.
SCAN_COMMUNITY=ALTERE_PARA_A_COMMUNITY_SNMP

# Intervalo entre varreduras automáticas, em segundos.
SCAN_INTERVAL=300

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Necessária para manter sessões de login válidas após reiniciar o servidor.
RADAR_SECRET_KEY=
RADAR_COOKIE_SECURE=false

# Descoberta auxiliar ICMP; ajuda a encontrar hosts sem SNMP, mas não os garante.
DISCOVERY_CONCURRENCY=32
DISCOVERY_PING_TIMEOUT_MS=800

# Tempo sem receber coleta antes de marcar um computador com agente como offline.
AGENT_OFFLINE_AFTER_SECONDS=900

# WMI/WinRM foi usado apenas para validação de laboratório; não é a coleta
# planejada para implantação do agente RADAR.
SCAN_WMI_USERNAME=
SCAN_WMI_PASSWORD=
SCAN_WMI_PORT=5985
SCAN_WMI_HTTPS=false

# Segredo compartilhado apenas para autorizar o primeiro registro dos agentes.
# Gere um valor aleatório forte e mantenha-o somente no .env local.
RADAR_AGENT_ENROLLMENT_TOKEN=

# HTTPS opcional: disponibilize certificado e chave fora do Git e informe
# os caminhos visíveis pelo processo do RADAR (no Docker, dentro de /app).
RADAR_TLS_CERT_FILE=
RADAR_TLS_KEY_FILE=
